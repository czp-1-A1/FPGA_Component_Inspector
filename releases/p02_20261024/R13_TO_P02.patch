+  $display("SURFACE native frame%0d objects%0d checks%0d means%0d",frame_no,valid_objects,surface_checks,surface_mean_checks);
+ end
+endtask
+
+task check_review_probe;
+ reg [75:0] ob;reg [63:0] tuple;integer cx,cy,expected;
+ begin
+  for(integer lane=0;lane<2;lane++)begin
+   ob=meta[198+lane*152+:76];tuple=meta[502+lane*64+:64];
+   if(!ob[75] || ob[74:73]!=2 || !tuple[63] || !tuple[62] || tuple[61] || tuple[60:57]!==ob[72:69])
+    $fatal(1,"native probe object/source binding frame%0d lane%0d ob=%h tuple=%h",frame_no,lane,ob,tuple);
+   cx=2*((int'(ob[41:31])+2)/2+int'(ob[55:49])/4);
+   cy=2*((int'(ob[19:10])+2)/2+int'(ob[48:42])/4);
+   for(integer feature=0;feature<5;feature++)begin
+    expected=mean_reference(cx,cy,feature);probe_checks++;
+    if(tuple[32-feature*8+:8]!==8'(expected))
+     $fatal(1,"native probe mean frame%0d lane%0d feature%0d got%0d expected%0d",frame_no,lane,feature,tuple[32-feature*8+:8],expected);
