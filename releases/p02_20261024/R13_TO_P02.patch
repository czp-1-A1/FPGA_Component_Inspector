+   POP_VALUE:begin cx<=q_q[XB-1:0];cy<=q_q[QB-1:XB];q_head<=q_head+1'b1;q_count<=q_count-1'b1;direction<=0;phase<=NEIGH_REQ;end
+   NEIGH_REQ:begin
+    if(neighbor_ok)begin nx<=trial_x[XB-1:0];ny<=trial_y[YB-1:0];mem_addr<=address(trial_x[XB-1:0],trial_y[YB-1:0]);phase<=NEIGH_WAIT;end
+    else phase<=NEIGH_NEXT;
+   end
+   NEIGH_WAIT:phase<=NEIGH_CHECK;
+   NEIGH_CHECK:begin
+    if(active_ignored)border<=1;
+    if(neighbor_foreground)begin
+     if(q_count==1024 || component_count==W*H)begin ready<=1;sample_new<=1;state<=1;located<=0;phase<=FINISHED;end
+     else begin
+      mem_write_addr<=mem_addr;mem_data<=mem_q & ~(8'b1<<nx[1:0]);mem_write<=1;
+      q_write_addr<=q_tail;q_data<={ny,nx};q_write<=1;q_tail<=q_tail+1'b1;q_count<=q_count+1'b1;
+      component_count<=component_count+1'b1;
+      if(!high_q[4+nx[1:0]] && bright_count<6)bright_count<=bright_count+1'b1;
+      if(nx<xmin)xmin<=nx;if(nx>xmax)xmax<=nx;if(ny<ymin)ymin<=ny;if(ny>ymax)ymax<=ny;
+      if(nx==0 || nx==W-1 || ny==0 || ny==H-1)border<=1;
+     end
+    end
+    if(!(neighbor_foreground && (q_count==1024 || component_count==W*H)))begin
+     if(direction==3)begin
+      if(q_count==0 && !neighbor_foreground)phase<=AREA_CALC;else phase<=POP_REQ;
+     end else begin
+      direction<=direction+1'b1;
+      // Issue the next read now; the preceding mark has its own write address.
+      case(direction)
+       0:begin nx<=cx+1'b1;ny<=cy;mem_addr<=address(cx+1'b1,cy);phase<=cx<W-1 ? NEIGH_WAIT : NEIGH_NEXT;end
+       1:begin nx<=cx;ny<=cy-1'b1;mem_addr<=address(cx,cy-1'b1);phase<=cy!=0 ? NEIGH_WAIT : NEIGH_NEXT;end
+       2:begin nx<=cx;ny<=cy+1'b1;mem_addr<=address(cx,cy+1'b1);phase<=cy<H-1 ? NEIGH_WAIT : NEIGH_NEXT;end
+      endcase
+     end
+    end
+   end
+   NEIGH_NEXT:begin
+    if(direction==3)begin if(q_count==0)phase<=AREA_CALC;else phase<=POP_REQ;end
+    else begin direction<=direction+1'b1;phase<=NEIGH_REQ;end
+   end
+   AREA_CALC:begin high_confirmed<=0;candidate_region<=region_now;candidate_allowed<=allowed_now;component_area<=width_now*height_now;
+    long_side<=width_now>height_now ? width_now : height_now;short_side<=width_now<height_now ? width_now : height_now;phase<=SCALE;end
+   SCALE:begin
+    distance<=distance_now;
+    fg20<={4'b0,component_count}*23'd20;area17<={4'b0,component_area}*23'd17;
+    fg5<={4'b0,component_count}*23'd5;area3<={4'b0,component_area}*23'd3;
+    fg10<={4'b0,component_count}*23'd10;area9<={4'b0,component_area}*23'd9;
+    fg4<={2'b0,component_count,2'b0};
+    long20<={4'b0,long_side}*14'd20;short21<={4'b0,short_side}*14'd21;short31<={4'b0,short_side}*14'd31;
+    long5<={4'b0,long_side}*14'd5;short7<={4'b0,short_side}*14'd7;short9<={4'b0,short_side}*14'd9;phase<=COMPARE;
+   end
+   COMPARE:begin
+    phase<=SCAN_REQ;
+    if(high_shape && candidate_allowed && !border && component_count>=6 &&
+       width_now>=3 && height_now>=3 && (high_free || distance<high_worst))begin
+     high_boxes[high_write_index]<={ymax,ymin,xmax,xmin};
+     high_distances[high_write_index]<=distance;high_valid[high_write_index]<=1;
+    end
+    if(candidate_allowed && (!REGIONS || candidate_state!=0 || small_pass) && !border && (component_count>=8 || (small_pass && empty_match && component_count>=6)) && width_now>=3 && height_now>=3)begin
+     if(!small_pass)begin
+      if(ROW_GUARDED_BRIGHT_EMPTY && REGIONS && candidate_state==2 &&
+         (!row_anchor_valid[candidate_region] || distance<row_anchor_distance[candidate_region]))begin
+       row_anchor_valid[candidate_region]<=1;row_anchor_y[candidate_region]<=center_y;
+       row_anchor_distance[candidate_region]<=distance;
+      end
+      retain_candidate;
+      if(PLACEMENT_REVIEW && candidate_state==2)begin nx<=xmin & ~3;ny<=ymin;phase<=BODY_ACCOUNTED;end
+     end
+     else if(high_lookup)begin high_index<={candidate_region,2'b00};phase<=HIGH_REQ;end
+     else if((empty_match || sprocket_match || pose_match) && !covers_body)begin
+      for(bi=0;bi<SLOTS;bi=bi+1)if(found_bank[bi] && state_bank[bi]!=2 && bi/REGION_SLOTS==candidate_region &&
+       xmin_bank[bi]>=xmin && xmax_bank[bi]<=xmax && ymin_bank[bi]>=ymin && ymax_bank[bi]<=ymax)found_bank[bi]<=0;
+      if((empty_match || pose_match) && !sprocket_match)phase<=SMALL_INSERT;
+     end
+    end
+   end
+   HIGH_REQ:phase<=HIGH_CHECK;
+   HIGH_CHECK:begin
+    if(high_valid[high_index] && high_box_q=={ymax,ymin,xmax,xmin})begin
+     high_confirmed<=1;
+     // Remove T100 fragments contained in this independently measured T80
+     // contour, exactly as the original EMPTY insertion does.
+     for(bi=0;bi<SLOTS;bi=bi+1)if(found_bank[bi] && state_bank[bi]!=2 && bi/REGION_SLOTS==candidate_region &&
+       xmin_bank[bi]>=xmin && xmax_bank[bi]<=xmax && ymin_bank[bi]>=ymin && ymax_bank[bi]<=ymax)found_bank[bi]<=0;
+     phase<=SMALL_INSERT;
+    end else if(high_index[1:0]==3)phase<=SCAN_REQ;
+    else begin high_index<=high_index+1'b1;phase<=HIGH_REQ;end
+   end
+   SMALL_INSERT:begin retain_candidate;phase<=SCAN_REQ;end
+   BODY_ACCOUNTED:begin
+    if(nx+4>xmax)begin
+     nx<=xmin & ~3;
+     if(ny==ymax)phase<=SCAN_REQ;else ny<=ny+1'b1;
+    end else nx<=nx+4;
+   end
+   // Separate bbox-center arithmetic from dark-pixel counting and thresholds.
+   REF_ORIGIN:begin
+    if(!REGIONS && ref_index==1 && !legacy_pair_selected)phase<=PUBLISH;
+    else if(!found_bank[ref_index])begin
+     if(ref_index==SLOTS-1)phase<=PUBLISH;else ref_index<=ref_index+1'b1;
+    end else begin origin_x<=ref_cx;origin_y<=ref_cy;phase<=REF_REQ;end
+   end
+   REF_REQ:begin
+    mem_addr<=address(word_x[XB-1:0],word_y[YB-1:0]);
+    for(ref_lane_index=0;ref_lane_index<4;ref_lane_index=ref_lane_index+1)ref_mask[ref_lane_index]<=word_x>=0 && word_x<W && word_y<H &&
+     (ref_word==1 || (ref_word==0 && ref_lane_index>=origin_x[1:0]) || (ref_word==2 && ref_lane_index<origin_x[1:0]));
+    phase<=REF_WAIT;
+   end
+   REF_WAIT:phase<=REF_CHECK;
+   REF_CHECK:begin
+    if(ref_side)right_dark<=right_dark+dark_word;else left_dark<=left_dark+dark_word;
+    if(ref_side && ref_word==2 && ref_last_row)begin
+     if(REVIEW_PROBE)dark_bank[ref_index]<={left_dark[8] ? 8'hff : left_dark[7:0],(right_dark+dark_word)>=256 ? 8'hff : (right_dark[7:0]+{5'd0,dark_word})};
+     // Neighboring parts or a tape end may contaminate the side strips.
+     // Preserve a recognized 3528 body, but do not assert quality is normal.
+     if(state_bank[ref_index]==2)begin
+      // F is the generic weak-gray review code, not four failed measurements.
+      if(reason_bank[ref_index]!=4'hf)reason_bank[ref_index][3]<=left_dark<ref_min || right_dark+dark_word<ref_min;
+     end
+     else begin
+      reason_bank[ref_index]<=0;
+      if(left_dark<ref_min || right_dark+dark_word<ref_min)state_bank[ref_index]<=REGIONS ? 1 : 0;
+     end
+     if(ref_index==SLOTS-1)phase<=PUBLISH;
+     else begin ref_index<=ref_index+1'b1;ref_side<=0;ref_word<=0;ref_row<=0;left_dark<=0;right_dark<=0;phase<=REF_ORIGIN;end
+    end else begin
+     if(ref_word==2)begin ref_word<=0;if(ref_last_row)begin ref_row<=0;ref_side<=1;end else ref_row<=ref_row+1'b1;end
+     else ref_word<=ref_word+1'b1;
+     phase<=REF_REQ;
+    end
+   end
+   PUBLISH:begin
+     ready<=1;sample_new<=1;located<=primary_record[75];state<=primary_record[74:73];
+     review_required<=primary_record[74:73]==2 && |primary_record[72:69];
+     objects<=(!REGIONS && !legacy_pair_selected) ? {76'd0,records[75:0]} : sorted0;
+     region_objects<={sorted1,sorted0};recorder_objects<=recorder_packet;
+     foreground_count<=primary_record[68:56];box_width<=primary_record[55:49];box_height<=primary_record[48:42];
+     box_x0<=primary_record[41:31];box_x1<=primary_record[30:20];box_y0<=primary_record[19:10];box_y1<=primary_record[9:0];phase<=FINISHED;
+   end
+   default:begin end
+  endcase
+ end
+end
+
+generate if(REVIEW_PROBE && REGIONS)begin : review_measurement
+ wire [$clog2(SLOTS)-1:0] index0=found_bank[1] && (!found_bank[0] || xmin_bank[1]<xmin_bank[0]) ? 1 : 0;
+ wire [$clog2(SLOTS)-1:0] index1=found_bank[REGION_SLOTS+1] && (!found_bank[REGION_SLOTS] || xmin_bank[REGION_SLOTS+1]<xmin_bank[REGION_SLOTS]) ? REGION_SLOTS+1 : REGION_SLOTS;
+ wire [35:0] references={weak_bank[index1],found_bank[index1] && state_bank[index1]==2,dark_bank[index1],
+                       weak_bank[index0],found_bank[index0] && state_bank[index0]==2,dark_bank[index0]};
+ reg [15:0] first_gray;reg [31:0] gray_word;reg [10:0] gray_x;reg [9:0] gray_y;
+ always @(posedge clk or negedge rst_n)begin
+  if(!rst_n)begin first_gray<=0;gray_word<=0;gray_x<=0;gray_y<=0;end
+  else begin
+   if(accept_d && y_d[0] && !x_d[2])first_gray<={block1[9:2],block0[9:2]};
+   gray_word<={block1[9:2],block0[9:2],first_gray};gray_x<=x_d;gray_y<=y_d;
+   if(frame_start || invalidate || pixel_sof)first_gray<=0;
+  end
+ end
+ present_review_probe #(.WIDTH(WIDTH),.HEIGHT(HEIGHT)) probe(
+  .clk(clk),.rst_n(rst_n),.cancel(frame_start || invalidate || pixel_sof),
+  .write_enable(cap_write),.write_x(gray_x),.write_y(gray_y),.write_data(gray_word),
+  .measure(sample_new),.objects(region_objects),.references(references),.ready(probe_ready),.record(probe_record));
+end else begin : no_review_measurement
+ assign probe_record=0;assign probe_ready=1;
+end endgenerate
+endmodule
diff --git a/fpga/component_inspector/sim/surface/tb_present_surface_check.sv b/fpga/component_inspector/sim/surface/tb_present_surface_check.sv
new file mode 100644
index 00000000..ec6f0f2c
--- /dev/null
+++ b/fpga/component_inspector/sim/surface/tb_present_surface_check.sv
@@ -0,0 +1,97 @@
+`timescale 1ns/1ps
+module tb_present_surface_check;
+reg clk=0;always #5 clk=~clk;
+reg rst_n=0,cancel=0,we=0,measure=0;
+reg [10:0] wx=0;reg [9:0] wy=0;reg [31:0] wd=0;
+reg [9:0] xmin=0,xmax=0,ymin=0,ymax=0;
+wire ready,normal;
+present_surface_check dut(clk,rst_n,cancel,we,measure,wx,wy,wd,xmin,xmax,ymin,ymax,ready,normal);
+integer mode=0,cx=640,cy=320,checks=0,features=0;
+integer expected[0:4];integer actual_feature,waits,saved_features,ex_normal;
+function integer gray(input integer x,y);
+ integer v;
+ begin
+  if(mode==6)gray=(x*11+y*17+(x/8)*3)&255;
+  else begin
+   v=(mode==7 || mode==8) ? 200 : mode==9 ? 104 : mode==5 ? 96 : 248;
+   if(mode==11)v=254;if(mode==12)v=242;if(mode==13)v=175;
+   if(x>=cx-16 && x<cx-8 && y>=cy-8 && y<cy+8)
+    v=mode==3 ? 176 : (mode==7 || mode==8) ? 160 : mode==11 ? 224 : mode==12 ? 238 : mode==13 ? 214 : v;
+   if(x>=cx+8 && x<cx+16 && y>=cy-8 && y<cy+8)
+    v=mode==4 ? 176 : (mode==7 || mode==8) ? 160 : mode==11 ? 219 : mode==12 ? 226 : mode==13 ? 126 : v;
+   if(y>=cy-16 && y<cy-8 && x>=cx-8 && x<cx+8)
+    v=mode==1 ? 176 : mode==7 ? 160 : mode==8 ? 152 : mode==11 ? 229 : mode==12 ? 181 : mode==13 ? 157 : v;
+   if(y>=cy+8 && y<cy+16 && x>=cx-8 && x<cx+8)
+    v=mode==2 ? 176 : (mode==7 || mode==8) ? 160 : mode==11 ? 232 : mode==12 ? 206 : mode==13 ? 174 : v;
+   gray=v;
+  end
+ end
+endfunction
+task clear_frame;
+ begin @(negedge clk);cancel=1;we=0;measure=0;@(negedge clk);cancel=0;end
+endtask
+task capture(input integer skip_last);
+ integer x,y,k;reg [31:0] word_value;
+ begin
+  for(y=225;y<616;y=y+2)for(x=388;x<896;x=x+8)begin
+   word_value=0;for(k=0;k<4;k=k+1)word_value[k*8+:8]=gray(x-4+2*k,y-1);
+   @(negedge clk);wx=x;wy=y;wd=word_value;we=!(skip_last && x==892 && y==615);
+  end
+  @(negedge clk);we=0;repeat(2)@(negedge clk);
+ end
+endtask
+task reference;
+ integer f,x,y,x0,x1,y0,y1,total,n,minimum;
+ begin
+  for(f=0;f<5;f=f+1)begin
+   x0=cx-8;x1=cx+8;y0=cy-8;y1=cy+8;
+   case(f)
+    1:begin x0=cx-16;x1=cx-8;end
+    2:begin x0=cx+8;x1=cx+16;end
+    3:begin y0=cy-16;y1=cy-8;end
+    4:begin y0=cy+8;y1=cy+16;end
+   endcase
+   total=0;n=0;
+   for(y=y0;y<y1;y=y+2)for(x=x0;x<x1;x=x+2)begin total=total+(gray(x,y)>>3);n=n+1;end
+   expected[f]=total/n;
+  end
+  minimum=expected[1];for(f=2;f<5;f=f+1)if(expected[f]<minimum)minimum=expected[f];
+  ex_normal=expected[0]>=13 && 5*minimum>=4*expected[0];
+ end
+endtask
+always @(negedge clk)if(rst_n && !cancel && dut.phase==4 && dut.sample==(dut.feature==0 ? 63 : 31))begin
+ actual_feature=dut.feature;
+ if(dut.mean!==expected[actual_feature])$fatal(1,"feature %0d actual=%0d expected=%0d mode=%0d center=%0d,%0d",actual_feature,dut.mean,expected[actual_feature],mode,cx,cy);
+ features=features+1;
+end
+task request(input integer should_measure);
+ begin
+  reference;@(negedge clk);xmin=(cx-18)/2;xmax=xmin+17;ymin=(cy-24)/2;ymax=ymin+23;measure=1;
+  saved_features=features;@(negedge clk);measure=0;waits=0;
+  while(!ready && waits<700)begin @(negedge clk);waits=waits+1;end
+  if(!ready || normal!==(should_measure ? ex_normal : 0))$fatal(1,"completion mode=%0d ready=%b normal=%b expected=%0d",mode,ready,normal,should_measure ? ex_normal : 0);
+  if(features-saved_features!=(should_measure ? 5 : 0))$fatal(1,"unexpected feature count");
+  checks=checks+1;
+ end
+endtask
+integer k;
+initial begin
+ repeat(4)@(negedge clk);rst_n=1;
+ for(k=0;k<4;k=k+1)begin cx=400+2*k;cy=240;mode=6;clear_frame;capture(0);request(1);end
+ cx=878;cy=598;mode=6;clear_frame;capture(0);request(1);
+ cx=640;cy=320;
+ for(k=0;k<14;k=k+1)begin mode=k;clear_frame;capture(0);request(1);end
+ mode=0;clear_frame;capture(1);request(0);
+ clear_frame;capture(0);cx=382;request(0);cx=640;
+ reference;@(negedge clk);xmin=312;xmax=326;ymin=148;ymax=171;measure=1;
+ @(negedge clk);measure=0;repeat(3)@(negedge clk);if(!ready || normal)$fatal(1,"narrow body accepted");checks=checks+1;
+ clear_frame;capture(0);reference;
+ @(negedge clk);xmin=311;xmax=328;ymin=148;ymax=171;measure=1;
+ @(negedge clk);measure=0;repeat(20)@(negedge clk);clear_frame;
+ repeat(700)@(negedge clk);if(ready || normal)$fatal(1,"cancel leaked completion");checks=checks+1;
+ request(0);clear_frame;capture(0);request(1);request(1);
+ $display("PASS present surface: %0d requests, %0d exact independent five-bit means; four RAM phases, ROI edges, all dark-strip directions, ratio boundary, narrow/missing/cancel/restart",checks,features);
+ $finish;
+end
+initial begin #10000000;$fatal(1,"timeout");end
+endmodule
diff --git a/fpga/component_inspector/sim/surface/tb_surface_counting.v b/fpga/component_inspector/sim/surface/tb_surface_counting.v
new file mode 100644
index 00000000..f5bc647c
--- /dev/null
+++ b/fpga/component_inspector/sim/surface/tb_surface_counting.v
@@ -0,0 +1,84 @@
+`timescale 1ns/1ps
+// Pixel fixtures use the independently specified 180-mm classifier recipe.
+// They exercise the actual unchanged T100/T80 flood-fill, not injected boxes.
+module tb_surface_counting;
+ reg clk=0,rst_n=0,fs=0,sof=0,accept=0,commit=0,bad=0;
+ reg [10:0] x=0;reg [9:0] y=0;reg [95:0] rgb=0;
+ always #5 clk=~clk;
+ wire sn,ready;wire [303:0] objects;wire [255:0] packet,live;
+ wire cr,ev;wire [15:0] er;wire [8:0] ei;wire [31:0] ef;wire [1:0] ek;wire [3:0] em;
+ reg [16:0] command=0;
+ frame_shape_search #(.SURFACE_REVIEW(1),.REVIEW_PROBE(1),.WIDTH(1280),.HEIGHT(720),.REGIONS(1)) detector(
+  .clk(clk),.rst_n(rst_n),.frame_start(fs),.pixel_sof(sof),.pixel_accept(accept),.invalidate(bad),
+  .pixel_x(x),.pixel_y(y),.rgb(rgb),.ready(ready),.sample_new(sn),.region_objects(objects));
+ classified_count_pipeline #(.STOP_CYCLES(1500000),.PAGE_CYCLES(2000000)) pipeline(
+  .clk(clk),.rst_n(rst_n),.source_start(fs),.frame_commit(commit),.frame_bad(bad),.sample_new(sn),
+  .config_tag(64'h0444002800006464),.objects(objects),.command(command),
+  .frame_record(packet),.record_ready(cr),.live_record(live),
+  .event_valid(ev),.event_run(er),.event_id(ei),.event_frame(ef),.event_kind(ek),.event_reason(em));
+ integer offset=0,f,px,py,l,v,z,n,dx,dy,ux,uy,events=0,checked=0,cycles,kind;
+ function integer circle(input integer xx,yy,n);
+  begin circle=xx>=0 && xx<n && yy>=0 && yy<n;
+   if(n==5 && (xx==0 || xx==4) && (yy==0 || yy==4))circle=0;
+   if(n==7 && (((xx==0 || xx==6) && (yy<2 || yy>=5)) || ((xx==1 || xx==5) && (yy==0 || yy==6))))circle=0;
+  end
+ endfunction
+ function integer image(input integer xx,yy);
+  integer index,cx,dx,dy,ux,uy;
+  begin
+   image=30;
+   if(yy>=250 && yy<350)begin
+    index=(xx-offset-640+8040)/80-100;
+    cx=640+index*80+offset;dx=xx-cx;dy=yy-320;
+    if((index+300)%3!=0)begin
+     if(dx>=-18 && dx<18 && dy>=-22 && dy<22)begin
+      ux=(dx+18)/2;uy=(dy+22)/2;
+      if(!((ux<2 || ux>=16) && (uy<4 || uy>=18)))image=180;
+     end
+    end else begin
+     ux=(dx+5)/2;uy=(dy+5)/2;
+     if(dx>=-5 && dy>=-5 && circle(ux,uy,5))image=90;
+    end
+    // The round feed holes are visible but must never generate an event.
+    dy=yy-280;ux=(dx+7)/2;uy=(dy+7)/2;
+    if(dx>=-7 && dy>=-7 && circle(ux,uy,7))begin image=90;if(ux>=2 && ux<5 && uy>=2 && uy<5)image=110;end
+   end
+  end
+ endfunction
+ task ticks(input integer count);begin repeat(count)@(negedge clk);end endtask
+ always @(negedge clk)if(ev)begin
+  if(ek==2 && em!=0)$fatal(1,"normal body event retained review flags");
+  events++;kind=(300-events)%3==0 ? 3 : 2;
+  if(ei!=events || er!=1 || ek!=kind || ef!=f+1)$fatal(1,"actual classifier event mismatch id%0d kind%0d expected%0d frame%0d/%0d",ei,ek,kind,ef,f+1);
+  $display("EVENT source=%0d pocket=%0d class=%0d reason=%h",ef,ei,ek,em);
+ end
+ initial begin
+  ticks(5);rst_n=1;ticks(5);command=2;ticks(5);
+  for(f=0;f<70;f++)begin
+   fs=1;ticks(1);fs=0;ticks(3);
+   for(py=0;py<720;py++)begin
+    for(px=0;px<1280;px+=4)begin
+     x=px;y=py;accept=1;sof=px==0 && py==0;
+     for(l=0;l<4;l++)begin v=image(px+l,py);rgb[95-l*24-:24]={3{8'(v)}};end
+     ticks(1);accept=0;sof=0;
+    end
+    ticks(2);
+   end
+   commit=1;ticks(1);commit=0;cycles=0;
+   while(!cr && cycles<600000)begin ticks(1);cycles++;end
+   if(!cr || packet[50:48]==3)$fatal(1,"image counting lost frame=%0d state=%0d reason=%0d ready=%b",f,packet[50:48],packet[54:51],cr);
+   if(packet[31:0]!=f+1 || !packet[223] || packet[66:58]!=events)$fatal(1,"packet source/count binding");
+   for(z=0;z<4;z++)if(objects[z*76+75])begin
+    if(z>=2 || objects[z*76+19-:10]+objects[z*76+9-:10]<620)$fatal(1,"feed hole/other region retained");
+    checked++;
+   end
+   if(f%20!=0 && f%20!=1)offset=offset+6;
+  end
+  if(events<3 || live[84:76]!=1 || live[138:130]!=3)$fatal(1,"mixed count/empty-ID truth events%0d empty%0d first%0d",events,live[84:76],live[138:130]);
+  // No source clock/CSI: independent process watchdog must retain the ledger.
+  ticks(1500200);
+  if(live[50:48]!=3 || live[54:51]!=6 || live[66:58]!=events)$fatal(1,"CSI-stop fail-safe");
+  $display("PASS surface counting: 70 actual T100/T80 frames, %0d classified observations, %0d crossings incl empty #3, feed exclusion, pause and independent CSI-stop",checked,events);$finish;
+ end
+ initial begin #500000000;$fatal(1,"image test watchdog");end
+endmodule
diff --git a/fpga/component_inspector/sim/surface/tb_surface_detector.sv b/fpga/component_inspector/sim/surface/tb_surface_detector.sv
new file mode 100644
index 00000000..0be80af7
--- /dev/null
+++ b/fpga/component_inspector/sim/surface/tb_surface_detector.sv
@@ -0,0 +1,124 @@
+`timescale 1ns/1ps
+module tb_surface_detector;
+reg clk=0,rst_n=0,fs=0,sof=0,accept=0,cancel=0;
+reg [10:0] x=0;reg [9:0] y=0;reg [95:0] rgb=0;always #5 clk=~clk;
+wire ar,an,br,bn,cr,cn,apr,bpr,cpr;
+wire [151:0] ao,bo,co;wire [303:0] az,bz,cz;wire [607:0] ac,bc,cc;
+wire [127:0] ap,bp,cp;
+frame_shape_search_p01 #(.REVIEW_PROBE(1),.WIDTH(1280),.HEIGHT(720),.REGIONS(1),.COUNT_EMPTY_MARGIN(1),
+ .ROW_GUARDED_BRIGHT_EMPTY(1),.COUNT_CANDIDATES(1),.MULTITHRESHOLD_EMPTY(1)) baseline(
+ .clk(clk),.rst_n(rst_n),.frame_start(fs),.pixel_sof(sof),.pixel_accept(accept),.invalidate(cancel),
+ .pixel_x(x),.pixel_y(y),.rgb(rgb),.ready(ar),.sample_new(an),.objects(ao),.region_objects(az),.recorder_objects(ac),
+ .recorder_hold_valid(1'b0),.recorder_hold_x(11'd0),.recorder_hold_y(10'd0),.probe_record(ap),.probe_ready(apr));
+frame_shape_search #(.SURFACE_REVIEW(1),.REVIEW_PROBE(1),.WIDTH(1280),.HEIGHT(720),.REGIONS(1),.COUNT_EMPTY_MARGIN(1),
+ .ROW_GUARDED_BRIGHT_EMPTY(1),.COUNT_CANDIDATES(1),.MULTITHRESHOLD_EMPTY(1)) candidate(
+ .clk(clk),.rst_n(rst_n),.frame_start(fs),.pixel_sof(sof),.pixel_accept(accept),.invalidate(cancel),
+ .pixel_x(x),.pixel_y(y),.rgb(rgb),.ready(br),.sample_new(bn),.objects(bo),.region_objects(bz),.recorder_objects(bc),
+ .recorder_hold_valid(1'b0),.recorder_hold_x(11'd0),.recorder_hold_y(10'd0),.probe_record(bp),.probe_ready(bpr));
+frame_shape_search #(.SURFACE_REVIEW(0),.REVIEW_PROBE(1),.WIDTH(1280),.HEIGHT(720),.REGIONS(1),.COUNT_EMPTY_MARGIN(1),
+ .ROW_GUARDED_BRIGHT_EMPTY(1),.COUNT_CANDIDATES(1),.MULTITHRESHOLD_EMPTY(1)) default_off(
+ .clk(clk),.rst_n(rst_n),.frame_start(fs),.pixel_sof(sof),.pixel_accept(accept),.invalidate(cancel),
+ .pixel_x(x),.pixel_y(y),.rgb(rgb),.ready(cr),.sample_new(cn),.objects(co),.region_objects(cz),.recorder_objects(cc),
+ .recorder_hold_valid(1'b0),.recorder_hold_x(11'd0),.recorder_hold_y(10'd0),.probe_record(cp),.probe_ready(cpr));
+integer scene=0,clocks=0,checks=0,means=0,changed=0,seen_baseline=0;
+reg [607:0] saved_base;
+always @(negedge clk)if(rst_n)begin
+ clocks++;
+ if({ar,an,ao,az,ac,apr,ap}!=={cr,cn,co,cz,cc,cpr,cp})$fatal(1,"default-off P01 mismatch clock%0d scene%0d",clocks,scene);
+ if(an)begin saved_base=ac;seen_baseline=1;end
+end
+function automatic integer center(input integer p);
+ begin center=scene==1 ? 556+p*56 : p==0 ? 404 : p==1 ? 560 : p==2 ? 720 : 876;end
+endfunction
+function automatic integer image(input integer xx,yy);
+ integer cx,cy,w,h,back;
+ begin
+  image=30;w=scene==5 ? 30 : scene==6 ? 44 : 36;h=scene==5 ? 38 : scene==6 ? 38 : 48;
+  if(scene!=7)for(integer bank=0;bank<2;bank++)for(integer p=0;p<4;p++)begin
+   cx=center(p)+(scene==5);cy=(scene==4 ? (bank ? 516 : 320) : (bank ? 598 : 242))+(scene==5);back=scene==2 || (scene==3 && p%2==1);
+   if(xx>=cx-w/2 && xx<cx+w/2 && yy>=cy-h/2 && yy<cy+h/2)begin
+    image=scene==4 ? 90 : 224;
+    if(scene!=4)begin
+     if(xx>=cx-8 && xx<cx+8 && yy>=cy-8 && yy<cy+8)image=back ? 242 : 254;
+     if(xx>=cx-16 && xx<cx-8 && yy>=cy-8 && yy<cy+8)image=back ? 238 : 224;
+     if(xx>=cx+8 && xx<cx+16 && yy>=cy-8 && yy<cy+8)image=back ? 226 : 219;
+     if(yy>=cy-16 && yy<cy-8 && xx>=cx-8 && xx<cx+8)image=back ? 181 : 229;
+     if(yy>=cy+8 && yy<cy+16 && xx>=cx-8 && xx<cx+8)image=back ? 206 : 232;
+     if(scene==6 && xx>=cx+2 && xx<cx+16 && yy>=cy-14 && yy<cy+14)image=30;
+    end
+   end
+  end
+ end
+endfunction
+function automatic integer scalar_mean(input integer cx,cy,f);
+ integer x0,x1,y0,y1,total,n,quad;
+ begin
+  x0=cx-8;x1=cx+8;y0=cy-8;y1=cy+8;
+  case(f)1:begin x0=cx-16;x1=cx-8;end 2:begin x0=cx+8;x1=cx+16;end
+   3:begin y0=cy-16;y1=cy-8;end 4:begin y0=cy+8;y1=cy+16;end endcase
+  total=0;n=0;
+  for(integer y=y0;y<y1;y+=2)for(integer x=x0;x<x1;x+=2)begin
+   quad=image(x,y)+image(x+1,y)+image(x,y+1)+image(x+1,y+1);
+   total+=(quad/4)/8;n++;
+  end
+  scalar_mean=total/n;
+ end
+endfunction
+task tick;@(negedge clk);endtask
+task check_packet(input [607:0] actual,original);
+ reg [75:0] a,b,masked_a,masked_b;integer cx,cy,c,m,e,pass,valids;
+ begin
+  valids=0;
+  for(integer slot=0;slot<8;slot++)begin
+   a=actual[slot*76+:76];b=original[slot*76+:76];masked_a=a;masked_b=b;
+   if(a[75] && a[74:73]==2)begin
+    masked_a[72]=0;masked_b[72]=0;valids++;
+    cx=int'(a[41:31])+2+2*(int'(a[55:49])/4);
+    cy=int'(a[19:10])+2+2*(int'(a[48:42])/4);
+    c=scalar_mean(cx,cy,0);m=31;
+    for(integer f=1;f<5;f++)begin e=scalar_mean(cx,cy,f);if(e<m)m=e;end
+    pass=c>=13 && m*5>=c*4 && a[55:49]>=32 && a[48:42]>=32;
+    means+=5;
+    if(a[72] !== (scene==4 ? 1'b1 : !pass))$fatal(1,"surface reason scene%0d slot%0d C5%0d min5%0d a=%h b=%h",scene,slot,c,m,a,b);
+    if(scene<=1 && a[72:69]!==0)$fatal(1,"normal not released");
+    if(scene==2 && a[72:69]!==8)$fatal(1,"back was released");
+    if(scene==4 && a[72:69]!==15)$fatal(1,"weakT80 was released");
+    if(scene==5 && !a[69])$fatal(1,"narrow geometry was released");
+    if(scene==6 && !a[71])$fatal(1,"fill guard was released");
+    if(a[72]!=b[72])changed++;
+   end
+   if(masked_a!==masked_b)$fatal(1,"changed non-quality field scene%0d slot%0d got=%h original=%h",scene,slot,a,b);
+   checks++;
+  end
+  if(valids!=(scene==7 ? 0 : 8))$fatal(1,"fixture retained %0d of8 real bodies scene%0d",valids,scene);
+ end
+endtask
+task frame(input integer n);
+ integer px,py,k,v,waits;
+ begin
+  scene=n;fs=1;tick;fs=0;seen_baseline=0;repeat(3)tick;
+  for(py=0;py<720;py++)begin
+   for(px=0;px<1280;px+=4)begin
+    x=px;y=py;accept=1;sof=(px==0 && py==0);
+    for(k=0;k<4;k++)begin v=image(px+k,py);rgb[95-k*24-:24]={8'(v+1),8'(v),8'(v-1)};end
+    tick;accept=0;sof=0;
+   end
+   repeat(2)tick;
+  end
+  waits=0;while(!bpr && waits<900000)begin tick;waits++;end
+  if(!bpr || !seen_baseline)$fatal(1,"result not complete scene%0d",scene);
+  check_packet(bc,saved_base);
+  $display("SURFACE RGB scene%0d checks%0d means%0d changed%0d cycles%0d records=%h",scene,checks,means,changed,waits,bc);
+  cancel=1;tick;cancel=0;repeat(2)tick;
+  if(br || bn || bpr || bo!==0 || bz!==0 || bc!==0 || bp!==0)$fatal(1,"cancel retained result");
+ end
+endtask
+initial begin
+ repeat(5)tick;rst_n=1;repeat(5)tick;
+ for(integer n=0;n<8;n++)frame(n);
+ if(changed<8)$fatal(1,"no neighbouring-strip false-review reproduction");
+ $display("PASS surface detector:8 full720p RGB frames, %0d recorder records, %0d independent means, %0d quality bits changed, %0d clocks default-off EXACT P01; all8 slots, ROI edges, neighbours/front/back/geometry/fill/weak/cancel",checks,means,changed,clocks);
+ $finish;
+end
+initial begin #150000000;$fatal(1,"watchdog");end
+endmodule
