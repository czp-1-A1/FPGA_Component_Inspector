+  ((dut.post_y>=288 && dut.post_y<352) || (dut.post_y>=484 && dut.post_y<548)))
+  $fwrite(trace,"%0d %0d %0d %0d %024h\n",frame_no,dut.post_x,dut.post_y,dut.post_tag[1:0],dut.post_rgb);
+end
+integer displays=0,checked_pixels=0,nonzero_pixels=0,accepted_frames=0,commits=0;
+integer luma[0:921599];reg [75:0] aa,bb;
+real frame_time,previous_fs=0,publish_time=0,result_time=0;
+reg published_d=0,mready_d=0;
+always @(posedge dclk)begin
+ published_d<=writer.published;
+ if(writer.published && !published_d)publish_time=$realtime;
+end
+always @(posedge procclk)begin
+ mready_d<=mready;
+ if(mready && !mready_d)result_time=$realtime;
+end
+always @(posedge procclk)if(rst)begin
+ if(dut.post_commit)commits++;
+ if(dut.post_accept)for(integer k=0;k<4;k++)luma[dut.post_y*1280+dut.post_x+k]=
+  (int'(dut.post_rgb[95-k*24-:8])+2*int'(dut.post_rgb[87-k*24-:8])+int'(dut.post_rgb[79-k*24-:8]))/4;
+end
+integer probe_checks=0;
+function automatic integer mean_reference(input integer center_x,center_y,feature);
+ integer sx,sy,nx,ny,total,cells,quad;
+ begin
+  sx=center_x-8;sy=center_y-8;nx=16;ny=16;
+  case(feature)
+   1:begin sx=center_x-16;nx=8;end
+   2:begin sx=center_x+8;nx=8;end
+   3:begin sy=center_y-16;ny=8;end
+   4:begin sy=center_y+8;ny=8;end
+  endcase
+  total=0;cells=0;
+  for(integer yy=sy;yy<sy+ny;yy+=2)for(integer xx=sx;xx<sx+nx;xx+=2)begin
+   quad=luma[yy*1280+xx]+luma[yy*1280+xx+1]+luma[(yy+1)*1280+xx]+luma[(yy+1)*1280+xx+1];
+   total+=quad/4;cells++;
+  end
+  mean_reference=total/cells;
+ end
+endfunction
+integer surface_checks=0,surface_mean_checks=0;
+function automatic integer surface_mean(input integer center_x,center_y,f);
+ integer x0,x1,y0,y1,total,n,quad;
+ begin
+  x0=center_x-8;x1=center_x+8;y0=center_y-8;y1=center_y+8;
+  case(f)
+   1:begin x0=center_x-16;x1=center_x-8;end
+   2:begin x0=center_x+8;x1=center_x+16;end
+   3:begin y0=center_y-16;y1=center_y-8;end
+   4:begin y0=center_y+8;y1=center_y+16;end
+  endcase
+  total=0;n=0;
+  for(integer y=y0;y<y1;y+=2)for(integer x=x0;x<x1;x+=2)begin
+   quad=luma[y*1280+x]+luma[y*1280+x+1]+luma[(y+1)*1280+x]+luma[(y+1)*1280+x+1];
+   total+=(quad/4)/8;n++;
+  end
+  surface_mean=total/n;
+ end
+endfunction
+// Independent scalar image oracle, applied to all real recorder objects in this frame.
+task check_surface;
+ reg [75:0] ob;integer cx,cy,c,m,e,expected,valid_objects;
+ begin
+  valid_objects=0;
+  for(integer slot=0;slot<8;slot++)begin
+   ob=dut.local_shape_detection.detector.recorder_objects[slot*76+:76];
+   if(ob[75] && ob[74:73]==2)begin
+    valid_objects++;
+    cx=2*((int'(ob[41:31])+2)/2+int'(ob[55:49])/4);
+    cy=2*((int'(ob[19:10])+2)/2+int'(ob[48:42])/4);
+    c=surface_mean(cx,cy,0);m=31;
+    for(integer f=1;f<5;f++)begin e=surface_mean(cx,cy,f);if(e<m)m=e;end
+    surface_mean_checks+=5;expected=c>=13 && 5*m>=4*c;
+    if(ob[72]!==!expected)$fatal(1,"native surface mismatch frame%0d slot%0d C5=%0d min5=%0d ob=%h",frame_no,slot,c,m,ob);
